{
  "latex-workshop.latex.recipe.default": "LuaLaTeX + Biber + LuaLaTeX x2",
  "latex-workshop.latex.recipes": [
    {
      "name": "LuaLaTeX + Biber + LuaLaTeX x2",
      "tools": [
        "lualatex",
        "biber",
        "lualatex",
        "lualatex"
      ]
    },
    {
      "name": "latexmk (lualatex)",
      "tools": [
        "lualatexmk"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "lualatex",
      "command": "lualatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOCFILE_EXT%"
      ],
      "cwd": "%DIR%"
    },
    {
      "name": "biber",
      "command": "biber",
      "args": [
        "%DOCFILE%"
      ],
      "cwd": "%DIR%"
    },
    {
      "name": "lualatexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-lualatex",
        "%DOC_EXT%"
      ],
      "cwd": "%DIR%"
    }
  ],
  "latex-workshop.view.pdf.viewer": "tab"
}
